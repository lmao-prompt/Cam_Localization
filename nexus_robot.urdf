<?xml version="1.0"?>
<robot name="nexus">

  <!-- Base link -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.20 0.15 0.08"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.4 0.8 1.0"/>
      </material>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.20 0.15 0.08"/>
      </geometry>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
    </collision>
  </link>

  <!-- Left wheel -->
  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.025"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </visual>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.0875 0.035" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Right wheel -->
  <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.025"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </visual>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.0875 0.035" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Caster wheel (front) -->
  <link name="caster">
    <visual>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster"/>
    <origin xyz="0.08 0 0.02" rpy="0 0 0"/>
  </joint>

  <!-- Direction arrow (visual only) -->
  <link name="arrow">
    <visual>
      <geometry>
        <box size="0.12 0.02 0.01"/>
      </geometry>
      <material name="red">
        <color rgba="1.0 0.0 0.0 1.0"/>
      </material>
      <origin xyz="0.06 0 0.09" rpy="0 0 0"/>
    </visual>
  </link>

  <joint name="arrow_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arrow"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>